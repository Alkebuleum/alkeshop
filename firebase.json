{
  "functions": [
    {
      "source": "functions",
      "codebase": "alkeshop",
      "ignore": ["node_modules", ".git", "test", "firebase-debug.log", "firebase-debug.*.log", "*.local"]
    }
  ],
  "firestore": [
    {
      "database": "alkeshop",
      "rules": "firestore.rules",
      "indexes": "firestore.indexes.json"
    }
  ],
  "storage": [
    {
      "target": "alkeshop",
      "rules": "storage.rules"
    }
  ],
  "emulators": {
    "auth": { "port": 9199 },
    "functions": { "port": 5101 },
    "firestore": { "port": 8180 },
    "storage": { "port": 9299 },
    "ui": { "enabled": false },
    "singleProjectMode": true
  }
}
